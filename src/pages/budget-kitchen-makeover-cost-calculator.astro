---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

// Each task: realistic UK cost range for a DIY, renter-safe / no-fitter approach.
// Sources: B&Q, IKEA, Wickes, Screwfix, Dunelm, Amazon UK pricing (2026).
const tasks = [
  { id: 'cabinets', label: 'Paint the cabinet doors & frames', low: 30, high: 70,
    detail: '2 tins of cupboard paint (Rust-Oleum ~£25 each) + roller and brush.',
    link: '/blog/budget-kitchen-cabinet-makeover-uk/' },
  { id: 'handles', label: 'Swap all the cabinet handles', low: 15, high: 45,
    detail: 'A multipack of brass or matte-black handles covers a whole kitchen.',
    link: '/blog/budget-kitchen-cabinet-makeover-uk/' },
  { id: 'worktop', label: 'Refresh the worktop (wrap film or paint kit)', low: 20, high: 45,
    detail: 'd-c-fix wrap roll ~£25, or a laminate worktop paint kit ~£40.',
    link: '/blog/budget-kitchen-worktop-makeover-uk/' },
  { id: 'splashback', label: 'Add a peel-and-stick splashback', low: 25, high: 50,
    detail: 'Tile-effect vinyl sheets for the area behind the hob and sink.',
    link: '/blog/budget-kitchen-splashback-tile-ideas-uk/' },
  { id: 'flooring', label: 'Lay new vinyl or laminate flooring', low: 60, high: 180,
    detail: 'Self-adhesive vinyl tiles or click laminate for a ~6 m² kitchen.',
    link: '/blog/budget-kitchen-flooring-ideas-uk/' },
  { id: 'tap', label: 'Fit a new kitchen tap', low: 35, high: 90,
    detail: 'A mixer tap from B&Q; a 30-minute job with an adjustable spanner.',
    link: '/blog/kitchen-on-a-budget-uk/' },
  { id: 'shelving', label: 'Put up open shelving', low: 25, high: 60,
    detail: 'Brackets plus timber or an IKEA shelf run on one wall.',
    link: '/blog/kitchen-on-a-budget-uk/' },
  { id: 'lighting', label: 'Update the lighting', low: 20, high: 60,
    detail: 'Plug-in under-cabinet LED strip, or a new pendant shade.',
    link: '/blog/kitchen-on-a-budget-uk/' },
  { id: 'window', label: 'New blind or window dressing', low: 15, high: 40,
    detail: 'A made-to-measure roller blind or a simple café curtain.',
    link: '/blog/kitchen-decor-ideas-uk/' },
  { id: 'styling', label: 'Style it (jars, board, plants, tea towels)', low: 15, high: 35,
    detail: 'The finishing layer that makes the whole thing read as intentional.',
    link: '/blog/kitchen-decor-ideas-uk/' },
];

const allLow = tasks.reduce((s, t) => s + t.low, 0);
const allHigh = tasks.reduce((s, t) => s + t.high, 0);
---

<html lang="en-GB">
  <head>
    <SEO
      title="Budget Kitchen Makeover Cost Calculator UK — Work Out Your Total"
      description="Tick the jobs you'll do and get a realistic £ total for a DIY budget kitchen makeover in the UK — cabinet paint, handles, worktops, splashback, flooring and more. No fitter needed."
      type="website"
      canonicalPath="/budget-kitchen-makeover-cost-calculator/"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://britishhomeinterior.co.uk" },
        { "@type": "ListItem", "position": 2, "name": "Budget Kitchen Makeover Cost Calculator", "item": "https://britishhomeinterior.co.uk/budget-kitchen-makeover-cost-calculator/" }
      ]
    })} />
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KZHMLD9Q"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <Header />

    <main class="calc">
      <div class="calc-inner">

        <header class="calc-head">
          <p class="calc-eyebrow">Free tool</p>
          <h1 class="calc-h1">Budget Kitchen Makeover Cost Calculator</h1>
          <p class="calc-sub">
            Tick the jobs you're planning to do yourself. The total updates as you go —
            realistic UK prices, no fitter, most of it renter-safe. A full replacement
            kitchen in the UK starts around <strong>£8,000</strong>; this is the other way.
          </p>
        </header>

        <div class="calc-grid">

          <form class="calc-list" id="calc-form">
            {tasks.map((t) => (
              <label class="task">
                <input type="checkbox" data-low={t.low} data-high={t.high} name={t.id} />
                <span class="task-body">
                  <span class="task-top">
                    <span class="task-label">{t.label}</span>
                    <span class="task-price">£{t.low}–£{t.high}</span>
                  </span>
                  <span class="task-detail">{t.detail} <a href={t.link}>Full guide →</a></span>
                </span>
              </label>
            ))}
          </form>

          <aside class="calc-result" aria-live="polite">
            <div class="result-card">
              <p class="result-label">Your makeover total</p>
              <p class="result-total" id="result-total">£0</p>
              <p class="result-band" id="result-band">Pick some jobs to start</p>
              <div class="result-bar"><span id="result-fill"></span></div>
              <p class="result-vs">
                Everything on the list: <strong>£{allLow}–£{allHigh}</strong><br>
                A full replacement kitchen: <strong>£8,000+</strong>
              </p>
              <button type="button" class="btn btn-primary result-print" onclick="window.print()">Print / save this</button>
            </div>
          </aside>

        </div>

        <section class="calc-notes">
          <h2>How the estimate works</h2>
          <p>
            Every figure is a DIY range — buying the materials and doing the job yourself
            over a weekend, not paying a tradesperson. The low end assumes budget brands
            (B&Q, IKEA, Wilko, Screwfix) and a small kitchen; the high end covers a larger
            room or a mid-range product choice. Prices checked in 2026 and rounded.
          </p>
          <p>
            The order to do them in: cabinets and handles first (biggest visual change per
            pound), then worktop and splashback, then flooring, then lighting and styling.
            Each job links to a full step-by-step guide above.
          </p>
          <p class="calc-back">
            Start here: <a href="/blog/kitchen-on-a-budget-uk/">Cheap Kitchen Makeover UK — 14 Affordable Ideas</a>
          </p>
        </section>

      </div>
    </main>

    <Footer />

    <script is:inline>
      (function () {
        var form = document.getElementById('calc-form');
        var totalEl = document.getElementById('result-total');
        var bandEl = document.getElementById('result-band');
        var fillEl = document.getElementById('result-fill');
        if (!form) return;
        var MAX = 675;
        function fmt(n) { return '£' + Math.round(n).toLocaleString('en-GB'); }
        function update() {
          var lo = 0, hi = 0, n = 0;
          form.querySelectorAll('input[type=checkbox]').forEach(function (c) {
            if (c.checked) { lo += +c.dataset.low; hi += +c.dataset.high; n++; }
          });
          totalEl.textContent = n === 0 ? '£0' : fmt(lo) + ' – ' + fmt(hi);
          var mid = (lo + hi) / 2;
          fillEl.style.width = Math.min(100, (mid / MAX) * 100) + '%';
          if (n === 0) bandEl.textContent = 'Pick some jobs to start';
          else if (mid < 150) bandEl.textContent = n + ' jobs · a light refresh';
          else if (mid < 400) bandEl.textContent = n + ' jobs · a proper makeover';
          else bandEl.textContent = n + ' jobs · a near-full transformation';
        }
        form.addEventListener('change', update);
        update();
      })();
    </script>

    <style>
      .calc { background: var(--color-bg); padding: 0 0 5rem; }
      .calc-inner { max-width: 940px; margin-inline: auto; padding-inline: 1.5rem; }

      .calc-head { padding: 3.5rem 0 2rem; max-width: 640px; }
      .calc-eyebrow {
        font-family: var(--font-body); font-size: 0.72rem; font-weight: 700;
        letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-gold);
        margin: 0 0 0.75rem;
      }
      .calc-h1 {
        font-family: var(--font-display); font-weight: 700; line-height: 1.15;
        font-size: clamp(1.9rem, 5vw, 2.7rem); color: var(--color-heading); margin: 0 0 1rem;
      }
      .calc-sub { font-size: 1rem; line-height: 1.7; color: var(--color-text-muted); margin: 0; }

      .calc-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: start; }
      @media (min-width: 860px) { .calc-grid { grid-template-columns: 1fr 300px; } }

      .calc-list { display: flex; flex-direction: column; gap: 0; border: 1px solid var(--color-border); background: var(--color-card); }
      .task {
        display: flex; gap: 0.9rem; padding: 1rem 1.15rem;
        border-bottom: 1px solid var(--color-border); cursor: pointer;
        transition: background 150ms;
      }
      .task:last-child { border-bottom: none; }
      .task:hover { background: var(--color-surface); }
      .task input { margin-top: 0.28rem; width: 18px; height: 18px; accent-color: var(--color-primary); flex-shrink: 0; }
      .task-body { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
      .task-top { display: flex; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; }
      .task-label { font-weight: 700; color: var(--color-heading); font-size: 0.95rem; }
      .task-price { font-family: var(--font-body); font-weight: 700; color: var(--color-gold); font-size: 0.9rem; white-space: nowrap; }
      .task-detail { font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.55; }
      .task-detail a { color: var(--color-primary); font-weight: 600; white-space: nowrap; }

      .calc-result { position: sticky; top: 1.5rem; }
      .result-card { background: var(--color-heading); color: #fff; padding: 1.5rem 1.4rem; }
      .result-label {
        font-size: 0.68rem; font-weight: 700; letter-spacing: 0.16em;
        text-transform: uppercase; color: var(--color-gold); margin: 0 0 0.5rem;
      }
      .result-total {
        font-family: var(--font-display); font-weight: 700;
        font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.1; margin: 0 0 0.35rem;
      }
      .result-band { font-size: 0.85rem; color: rgba(255,255,255,0.7); margin: 0 0 1rem; }
      .result-bar { height: 6px; background: rgba(255,255,255,0.15); margin-bottom: 1.25rem; }
      .result-bar span { display: block; height: 100%; width: 0; background: var(--color-gold); transition: width 250ms ease; }
      .result-vs { font-size: 0.82rem; line-height: 1.7; color: rgba(255,255,255,0.7); margin: 0 0 1.25rem; }
      .result-vs strong { color: #fff; }
      .result-print { width: 100%; justify-content: center; }

      .calc-notes { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border); max-width: 640px; }
      .calc-notes h2 {
        font-family: var(--font-display); font-style: italic; font-size: 1.4rem;
        color: var(--color-heading); margin: 0 0 1rem;
      }
      .calc-notes p { font-size: 0.95rem; line-height: 1.75; color: var(--color-text); margin: 0 0 1rem; }
      .calc-back a { color: var(--color-primary); font-weight: 600; }

      @media print {
        .site-header, .site-footer, .result-print, .task-detail a, .calc-eyebrow { display: none !important; }
        .calc-result { position: static; }
        .result-card { background: #fff !important; color: #000 !important; border: 1px solid #000; }
        .result-card * { color: #000 !important; }
      }
    </style>
  </body>
</html>
