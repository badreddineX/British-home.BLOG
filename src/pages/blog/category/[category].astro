---
import { getCollection } from 'astro:content';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SEO from '../../../components/SEO.astro';
import '../../../styles/global.css';

const CATEGORY_SLUGS: Record<string, string> = {
  'living-room':    'Living Room',
  'bedroom':        'Bedroom',
  'kitchen':        'Kitchen',
  'room-makeovers': 'Room Makeovers',
};

const CATEGORY_DESCRIPTIONS: Record<string, string> = {
  'Living Room':    'Living room styling ideas for UK homes — layout, colour schemes, and budget-friendly makeovers.',
  'Bedroom':        'Bedroom decor and makeover ideas for UK homes — cosy styling, colour, and layout, in pounds.',
  'Kitchen':        'Kitchen styling ideas for UK homes — budget upgrades and decor that work without a renovation.',
  'Room Makeovers': 'Full room makeover guides for UK homes and flats — real transformations, real UK prices.',
};

const CATEGORY_TITLES: Record<string, string> = {
  'Living Room':    'Living Room Ideas for UK Homes',
  'Bedroom':        'Bedroom Ideas for UK Homes',
  'Kitchen':        'Kitchen Ideas for UK Homes',
  'Room Makeovers': 'Room Makeover Ideas for UK Homes',
};

export async function getStaticPaths() {
  const slugs = ['living-room', 'bedroom', 'kitchen', 'room-makeovers'];
  return slugs.map(category => ({ params: { category } }));
}

const { category: categorySlug } = Astro.params;
const categoryName = CATEGORY_SLUGS[categorySlug as string];

function fmtDate(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => p.data.category === categoryName)
  .sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime());

// Grid cards don't need the raw source image (many are 1400x2100+).
const cardImg = (img: string) => img.replace('/images/', '/images/card/').replace(/\.(jpe?g|png)$/i, '.webp');
---

<html lang="en-GB">
  <head>
    <SEO
      title={CATEGORY_TITLES[categoryName]}
      description={CATEGORY_DESCRIPTIONS[categoryName]}
      type="website"
      canonicalPath={`/blog/category/${categorySlug}/`}
      noindex={true}
    />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KZHMLD9Q"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />

    <main>
      <div class="cat-page-heading">
        <nav class="cat-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/blog/">Blog</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">{categoryName}</span>
        </nav>
        <h1>{categoryName}</h1>
        <p>{CATEGORY_DESCRIPTIONS[categoryName]}</p>
      </div>

      <div class="bl-container">
        <div id="posts-grid">
          {posts.map(post => (
            <div class="bl-card">
              <a href={`/blog/${post.id}/`} class="bl-card-img-wrap" tabindex="-1" aria-hidden="true">
                <img
                  src={cardImg(post.data.image)}
                  alt={post.data.title}
                  width="720"
                  height="480"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="bl-card-body">
                <div class="bl-card-meta">
                  <span class="bl-avatar" aria-hidden="true"><img src="/logo.svg" alt="" width="28" height="28" /></span>
                  <span class="bl-author">Badreddine</span>
                  <span class="bl-dot" aria-hidden="true">·</span>
                  <time datetime={post.data.datePublished}>{fmtDate(post.data.datePublished)}</time>
                  <span class="bl-dot" aria-hidden="true">·</span>
                  <span>{post.data.readTime ?? '5 min read'}</span>
                </div>
                <h2 class="bl-card-title">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="bl-card-excerpt">{post.data.excerpt ?? post.data.description}</p>
                <span class="bl-card-cat">{post.data.category}</span>
              </div>
            </div>
          ))}
        </div>

        <a href="/blog/" class="cat-all-link">See all articles →</a>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .cat-page-heading {
    max-width: 1100px;
    margin-inline: auto;
    padding: 2.5rem 2rem 0.5rem;
  }
  .cat-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .cat-breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .cat-breadcrumb a:hover { color: var(--color-primary); }
  .cat-page-heading h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 700;
    color: var(--color-heading);
    margin: 0 0 0.5rem;
  }
  .cat-page-heading p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 620px;
  }
  @media (max-width: 600px) {
    .cat-page-heading { padding: 1.5rem 1.25rem 0.25rem; }
  }

  .bl-container {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: 2rem;
    padding-bottom: 5rem;
  }

  #posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-top: 2rem;
  }
  @media (max-width: 900px) { #posts-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { #posts-grid { grid-template-columns: 1fr; } }

  .bl-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    background: #fff;
    transition: box-shadow 250ms ease;
  }
  .bl-card:hover { box-shadow: 0 6px 28px rgba(0,0,0,0.08); }

  .bl-card-img-wrap {
    display: block;
    overflow: hidden;
    aspect-ratio: 16/10;
    background: var(--color-surface);
    flex-shrink: 0;
  }
  .bl-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 500ms ease;
  }
  .bl-card:hover .bl-card-img-wrap img { transform: scale(1.04); }

  .bl-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
  }
  .bl-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }
  .bl-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    vertical-align: middle;
  }
  .bl-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .bl-author { font-weight: 500; color: var(--color-text); }
  .bl-dot { color: var(--color-border); }

  .bl-card-title {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-weight: 700;
    color: var(--color-heading);
    line-height: 1.3;
    margin: 0;
  }
  .bl-card-title a { color: inherit; text-decoration: none; transition: color 200ms; }
  .bl-card-title a:hover { color: var(--color-primary); text-decoration: none; }

  .bl-card-excerpt {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bl-card-cat {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-top: auto;
  }

  .cat-all-link {
    display: inline-block;
    margin-top: 2.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    text-decoration: none;
    border-bottom: 1px solid var(--color-primary-dark);
    padding-bottom: 2px;
  }
  .cat-all-link:hover { color: var(--color-gold); border-color: var(--color-gold); text-decoration: none; }
</style>
