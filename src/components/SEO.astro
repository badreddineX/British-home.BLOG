---
import sharp from 'sharp';
import { join } from 'node:path';
import { readFileSync } from 'node:fs';

// Self-hosted fonts (was Google Fonts CDN -- removed 2 external DNS/connection
// round-trips from the critical render path, same fix already applied on
// Canada/Australia). Inlined at build time.
const fontCss = readFileSync(join(process.cwd(), 'public', 'fonts.css'), 'utf8');

interface Props {
  title: string;
  description: string;
  slug?: string;
  canonicalPath?: string;
  image?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  faqs?: { q: string; a: string }[];
}

const {
  title,
  description,
  slug = '',
  canonicalPath = '',
  image = '/images/pexels-1571453.jpg',
  datePublished = new Date().toISOString(),
  dateModified = new Date().toISOString(),
  authorName = 'Badreddine',
  type = 'website',
  noindex = false,
  faqs = [],
} = Astro.props;

const siteUrl = 'https://britishhomeinterior.co.uk';
const fullUrl = canonicalPath
  ? `${siteUrl}${canonicalPath}`
  : slug
  ? `${siteUrl}/blog/${slug}/`
  : siteUrl;
const fullImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const pageTitle = title.includes('British Home Interior') ? title : `${title} | British Home Interior`;
// The <title> tag drives the SERP snippet, which truncates past ~60 chars --
// Google then rewrites it itself, usually worse. Only keep the " | British
// Home Interior" suffix (24 chars) when the post title is short enough to
// leave room; otherwise ship the bare title. og:/twitter: keep the branded
// form since social cards don't truncate the same way.
const metaTitle = pageTitle.length <= 60 ? pageTitle : title;

// Pinterest Rich Pins and Facebook/LinkedIn crop og:image to the declared
// width/height, not the file's real dimensions -- a hardcoded 1200x630 lied
// for images that are actually ~1400x933 or portrait-oriented. Read the
// real file so the declaration always matches reality.
let ogImageWidth: number | null = null;
let ogImageHeight: number | null = null;
if (!image.startsWith('http')) {
  try {
    const imgPath = join(process.cwd(), 'public', image);
    const meta = await sharp(imgPath).metadata();
    ogImageWidth = meta.width ?? null;
    ogImageHeight = meta.height ?? null;
  } catch {
    // Leave null -- platforms fall back to reading the image's own header.
  }
}
---

<!-- Consent Mode defaults -- must be set before GTM loads. Denied by
     default; the cookie banner's Accept button (CookieConsent.astro)
     updates these to 'granted' and only then triggers GTM to actually
     load. Decline leaves everything denied and GTM never loads. -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
  gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    wait_for_update: 500,
  });
</script>

<!-- Google Tag Manager -->
<script is:inline>(function(w,d,s,l,i){
  function start(){
    w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  }
  // Real consent gate, not just Consent Mode signaling: GTM doesn't load
  // at all until the visitor has actually accepted -- stricter than
  // relying on GTM to honour the consent signal, and the behaviour
  // UK/EU visitors need under PECR/UK GDPR.
  w.__startAnalytics = start;
  if (localStorage.getItem('cookie-consent') === 'accepted') { start(); }
})(window,document,'script','dataLayer','GTM-KZHMLD9Q');</script>
<!-- End Google Tag Manager -->

<!-- Microsoft Clarity, issued via Bing Webmaster Tools account (ref=bwt).
     Consent-gated the same way as GTM above: defined now, only started for
     visitors who have accepted (CookieConsent.astro fires it on fresh accept). -->
<script is:inline>
  window.__startClarity = function(){
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "yakcbb6p60");
  };
  if (localStorage.getItem('cookie-consent') === 'accepted') { window.__startClarity(); }
</script>

<!-- Primary Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{metaTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
{!noindex && <link rel="canonical" href={fullUrl} />}
<link rel="alternate" type="application/rss+xml" title="British Home Interior" href="/rss.xml" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
<meta name="language" content="en-GB" />

<!-- Pinterest domain verification -->
<meta name="p:domain_verify" content="0c62cd4361e829dda2138488e9630aaf" />

<!-- Open Graph — Pinterest reads these for Rich Pins -->
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={fullUrl} />
<meta property="og:image" content={fullImage} />
{ogImageWidth  && <meta property="og:image:width"  content={String(ogImageWidth)} />}
{ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
<meta property="og:locale" content="en_GB" />
<meta property="og:site_name" content="British Home Interior" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImage} />

<!-- Article Meta (only for blog posts) -->
{type === 'article' && (
  <>
    <meta property="article:published_time" content={datePublished} />
    <meta property="article:modified_time" content={dateModified} />
    <meta property="article:author" content={authorName} />
  </>
)}

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- Fallback for broken images -->
<script is:inline>
window.addEventListener('error', function (e) {
  var t = e.target;
  if (t && t.tagName === 'IMG' && !t.dataset.fellBack) {
    t.dataset.fellBack = '1';
    t.removeAttribute('srcset');
    t.src = '/images/placeholder.svg';
  }
}, true);
</script>

<!-- Fonts: self-hosted, preload the two weights used above the fold
     (Lato 400 for body copy, Playfair Display 400 for the hero/H1) --
     removes the Google Fonts CDN round-trip (preconnect -> stylesheet ->
     discover font files) that was delaying text render on mobile. -->
<link rel="preload" as="font" type="font/woff2" href="/fonts/lato-400-normal-latin.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/playfair-display-400-normal-latin.woff2" crossorigin />
<style is:inline set:html={fontCss}></style>

<!-- Article Schema (JSON-LD) — only for blog posts -->
{type === 'article' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": fullImage,
    "datePublished": datePublished,
    "dateModified": dateModified,
    "author": {
      "@type": "Person",
      "@id": `${siteUrl}/about#person`,
      "name": authorName,
      "url": `${siteUrl}/about`
    },
    "publisher": {
      "@type": "Organization",
      "name": "British Home Interior",
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/logo.svg`
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": fullUrl
    }
  })} />
)}

<!-- Breadcrumb Schema — only for blog posts -->
{type === 'article' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog/` },
      { "@type": "ListItem", "position": 3, "name": title, "item": fullUrl }
    ]
  })} />
)}

<!-- FAQ Schema — only when the post supplies FAQs -->
{type === 'article' && faqs.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a.replace(/<[^>]+>/g, '') }
    }))
  })} />
)}

<!-- Organization Schema — real social profiles, same on every page -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "British Home Interior",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.svg`,
  "sameAs": [
    "https://www.instagram.com/britishhome_interior/",
    "https://www.pinterest.com/BritishHomeInterior"
  ]
})} />

<!-- Website Schema -->
{type === 'website' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "British Home Interior",
    "url": siteUrl,
    "description": "British home interior styling and room makeovers — cosy inspiration for UK homes, flats, and Victorian terraces.",
    "inLanguage": "en-GB"
  })} />
)}

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-54RDJL98V9"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-54RDJL98V9');
</script>
