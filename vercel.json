{
  "trailingSlash": true,
  "crons": [
    { "path": "/api/broadcast/", "schedule": "0 13 */2 * *" }
  ],
  "redirects": [
    { "source": "/blog/cosy-bedroom-decor-ideas-uk", "destination": "/blog/cosy-bedroom-ideas-uk", "permanent": true },
    { "source": "/blog/rented-home-decor-ideas-uk", "destination": "/blog/rented-flat-makeover-uk", "permanent": true },
    { "source": "/blog/living-room-budget-ideas-uk", "destination": "/blog/budget-home-makeover-uk", "permanent": true },
    { "source": "/blog/living-room-ideas-uk", "destination": "/blog/how-to-style-a-living-room-uk", "permanent": true },
    { "source": "/blog/small-flat-storage-ideas-uk", "destination": "/blog/small-bedroom-storage-uk", "permanent": true },
    { "source": "/blog/maximalist-home-decor-uk", "destination": "/blog/maximalist-living-room-decor-uk", "permanent": true },
    { "source": "/blog/bedroom-makeover-ideas-uk", "destination": "/blog/bedroom-makeover-uk", "permanent": true },
    { "source": "/blog/kitchen-colour-trends-uk-2026", "destination": "/blog/earthy-neutral-kitchen-colour-trends-uk", "permanent": true },
    { "source": "/blog/living-room-makeover-under-200", "destination": "/blog/budget-home-makeover-uk", "permanent": true },
    { "source": "/blog/small-bedroom-storage-ideas-uk", "destination": "/blog/small-bedroom-storage-uk", "permanent": true },
    { "source": "/blog/small-kitchen-ideas-uk", "destination": "/blog/small-kitchen-storage-ideas-budget-uk", "permanent": true },
    { "source": "/blog/victorian-terrace-makeover-uk", "destination": "/blog/victorian-terrace-interior-ideas-uk", "permanent": true }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms https://s.skimresources.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.clarity.ms https://vitals.vercel-insights.com https://s.skimresources.com https://t.skimresources.com; img-src 'self' data: https://www.google-analytics.com https://*.clarity.ms https://t.skimresources.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.googletagmanager.com; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
