# ─────────────────────────────────────────────────────────────
# Newsletter API — set in THIS blog's OWN Vercel project (Settings → Env Vars)
# for Production + Preview. Copy to .env.local for local testing (git-ignored).
# Everything here is separate from the smallspacehome blog.
# ─────────────────────────────────────────────────────────────

# Neon Postgres — POOLED connection string for THIS blog's OWN database
# (a separate Neon project or database, NOT smallspacehome's).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

SITE_URL="https://britishhomeinterior.co.uk"

# Hostinger mailbox for transactional email (confirm / welcome).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="hello@britishhomeinterior.co.uk"
SMTP_PASS="the-mailbox-password"

NEWSLETTER_FROM="British Home Interior <hello@britishhomeinterior.co.uk>"
NEWSLETTER_REPLY_TO="hello@britishhomeinterior.co.uk"

# Optional — physical postal address in the email footer.
# MAILING_ADDRESS="British Home Interior, 123 Example St, City, UK"

# ── Weekly digest (api/broadcast.js + Vercel Cron) ──────────────────
# THIS blog's OWN free Resend account (sign up with hello@britishhomeinterior.co.uk).
RESEND_API_KEY="re_xxxxxxxxxxxx"
NEWSLETTER_BULK_FROM="British Home Interior <hello@send.britishhomeinterior.co.uk>"

# Protects /api/broadcast. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="long-random-string"
